---
interface Props {
  title: string;
  description?: string;
  canonical?: string;
}

const {
  title,
  description = 'Ionic Swap — cross-chain token swapping with gasless transactions.',
  canonical,
} = Astro.props;

const nav = [
  { href: '/', label: 'App' },
  { href: '/learn', label: 'Learn' },
  { href: '/support', label: 'Support' },
  { href: '/contact', label: 'Contact' },
];

const footerLinks = [
  { href: '/learn', label: 'Learn DeFi' },
  { href: '/support', label: 'Support' },
  { href: '/contact', label: 'Contact' },
  { href: '/terms', label: 'Terms' },
  { href: '/privacy', label: 'Privacy' },
];
---

<!doctype html>
<html lang="en" class="dark">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <meta name="generator" content={Astro.generator} />
    <title>{title}</title>
    <meta name="description" content={description} />
    {canonical && <link rel="canonical" href={canonical} />}
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=IBM+Plex+Sans:wght@200;300;400;500;600;700;800&display=swap"
      rel="stylesheet"
    />
  </head>
  <body
    class="min-h-screen bg-zinc-100 dark:bg-zinc-900 text-zinc-900 dark:text-zinc-100 font-sans antialiased m-0 p-0"
  >
    <div class="min-h-screen flex flex-col">
      <header
        class="sticky top-0 z-40 w-full h-16 border-b border-zinc-200 dark:border-zinc-800 px-4 sm:px-6 flex items-center justify-between backdrop-blur-md bg-zinc-100/80 dark:bg-zinc-900/80"
      >
        <a href="/" class="flex items-center gap-3 select-none">
          <span
            class="w-8 h-8 rounded-lg bg-emerald-500/10 border border-emerald-400/30 flex items-center justify-center"
          >
            <svg
              class="w-5 h-5 text-emerald-500"
              viewBox="0 0 100 100"
              fill="none"
              stroke="currentColor"
              stroke-width="8"
            >
              <path d="M30,50 L50,20 L70,50 L50,80 Z"></path>
              <circle cx="50" cy="50" r="10" fill="currentColor"></circle>
            </svg>
          </span>
          <span class="text-sm font-bold font-mono tracking-widest uppercase hidden sm:inline"
            >IONIC_SWAP</span
          >
        </a>
        <nav class="flex items-center gap-1 sm:gap-4 text-sm">
          {
            nav.map((item) => (
              <a
                href={item.href}
                class="px-3 py-2 rounded-lg text-zinc-600 dark:text-zinc-300 hover:text-zinc-900 dark:hover:text-white hover:bg-zinc-200/60 dark:hover:bg-zinc-800 transition-colors"
              >
                {item.label}
              </a>
            ))
          }
        </nav>
      </header>

      <main class="flex-1 w-full">
        <slot />
      </main>

      <footer class="border-t border-zinc-200 dark:border-zinc-800 px-4 sm:px-6 py-6 mt-8">
        <div
          class="max-w-6xl mx-auto flex flex-col sm:flex-row items-center justify-between gap-3 text-xs text-zinc-500 dark:text-zinc-400"
        >
          <span>© {new Date().getFullYear()} Ionic Swap — World of Unreal. All rights reserved.</span>
          <div class="flex flex-wrap justify-center gap-4">
            {
              footerLinks.map((item) => (
                <a href={item.href} class="hover:text-emerald-500 transition-colors">
                  {item.label}
                </a>
              ))
            }
          </div>
        </div>
      </footer>
    </div>
  </body>
</html>

<style is:global>
  @import 'tailwindcss';

  :root {
    --font-sans: 'IBM Plex Sans', 'Helvetica Neue', Helvetica, Arial, sans-serif;
  }
  body {
    font-family: var(--font-sans);
  }

  .line-clamp-2 {
    display: -webkit-box;
    -webkit-line-clamp: 2;
    line-clamp: 2;
    -webkit-box-orient: vertical;
    overflow: hidden;
  }

  .prose-content h2 {
    font-size: 1.5rem;
    line-height: 2rem;
    font-weight: 700;
    margin-top: 2rem;
    margin-bottom: 1rem;
  }
  .prose-content h3 {
    font-size: 1.125rem;
    font-weight: 600;
    margin-top: 1.5rem;
    margin-bottom: 0.5rem;
  }
  .prose-content p {
    margin-bottom: 1rem;
    line-height: 1.75;
  }
  .prose-content ul {
    list-style: disc;
    padding-left: 1.25rem;
    margin-bottom: 1rem;
  }
  .prose-content ol {
    list-style: decimal;
    padding-left: 1.25rem;
    margin-bottom: 1rem;
  }
  .prose-content li {
    margin-bottom: 0.5rem;
    line-height: 1.75;
  }

  .scrollbar-thin::-webkit-scrollbar {
    width: 4px;
    height: 4px;
  }
  .scrollbar-thin::-webkit-scrollbar-thumb {
    background: rgba(156, 163, 175, 0.2);
    border-radius: 9999px;
  }
</style>
