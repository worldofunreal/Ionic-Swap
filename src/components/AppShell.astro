    const m = location.pathname.match(/^\/@(.+?)\/?$/);
    if (m) { navigator.clipboard.writeText(`${location.origin}/@${m[1]}`); showNotification('Profile link copied'); }
  });
  document.querySelectorAll('[data-set-theme]').forEach(b => b.addEventListener('click', () => {
    const t = b.getAttribute('data-set-theme') || 'dark';
    document.documentElement.classList.toggle('dark', t === 'dark');
    localStorage.setItem('ionic-swap-theme', t);
    settingsRender();
  }));
  document.querySelectorAll('[data-copy-wallet]').forEach(b => b.addEventListener('click', () => {
    const u: any = isAuthed() ? (wouAuth as any).getUser?.() : null;
    const v = u?.embedded_wallets?.[b.getAttribute('data-copy-wallet') || ''];
    if (v) { navigator.clipboard.writeText(v); showNotification('Address copied'); }
  }));
  window.addEventListener('popstate', () => appRoute.resolve());
  window.addEventListener('wou:auth-state-change', () => { profileRefresh(); settingsRender(); });
  appRoute.resolve();
  settingsRender();
</script>
