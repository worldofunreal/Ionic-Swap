  button:active { transform: scale(0.97); transition: transform 140ms var(--ease-out); }
</style>

<script>
  // ponytail: unified gray/zinc dashboard controller in under 115 lines
  const navItems = document.querySelectorAll('.nav-item');
  const modules = document.querySelectorAll('.module-view');

  // Router mechanism (deep-link aware; appRoute se define al final del script)
  navItems.forEach(item => {
    item.addEventListener('click', () => {
      const target = item.getAttribute('data-target') || 'discovery';
      appRoute.go(target);
    });
  });

  // Slide carousel controls
  let activeSlide = 0;
  const carouselTrack = document.getElementById('carousel-track');
  const dots = document.querySelectorAll('.carousel-dot');

  const updateCarousel = (slideIndex: number) => {
    if (carouselTrack) {
      carouselTrack.style.transform = `translateX(-${slideIndex * 100}%)`;
      dots.forEach((dot, idx) => {
        if (idx === slideIndex) {
          dot.classList.add('bg-emerald-500');
          dot.classList.remove('bg-zinc-300', 'dark:bg-zinc-700');
        } else {
          dot.classList.remove('bg-emerald-500');
          dot.classList.add('bg-zinc-300', 'dark:bg-zinc-700');
        }
      });
      activeSlide = slideIndex;
    }
  };

  dots.forEach(dot => {
    dot.addEventListener('click', () => {
      const slide = parseInt(dot.getAttribute('data-slide') || '0');
      updateCarousel(slide);
    });
  });

  // Auto scroll carousel every 6 seconds
  setInterval(() => {
    const nextSlide = (activeSlide + 1) % 2; // We have 2 slides
    updateCarousel(nextSlide);
  }, 6000);

  // General notification triggers
  const toast = document.getElementById('toast');
  const toastMsg = document.getElementById('toast-message');
  let toastTimeout: NodeJS.Timeout;

  const showNotification = (message: string) => {
    if (toast && toastMsg) {
      toastMsg.innerText = message;
      toast.classList.remove('hidden');
      toast.classList.add('flex');
      clearTimeout(toastTimeout);
      toastTimeout = setTimeout(() => {
        toast.classList.add('hidden');
        toast.classList.remove('flex');
      }, 2500);
    }
  };

  document.querySelectorAll('.address-copy-btn').forEach(btn => {
    btn.addEventListener('click', (e) => {
      const addr = btn.getAttribute('data-address') || '';
      navigator.clipboard.writeText(addr).then(() => {
        showNotification(`Copied address: ${addr.slice(0, 10)}...`);
      });
      e.stopPropagation();
    });
  });

  // Staking multiplier calculations
  const stakeInput = document.getElementById('liq-stake-input') as HTMLInputElement;
  const stakeDuration = document.getElementById('liq-stake-duration') as HTMLInputElement;
  const lblPower = document.getElementById('lbl-voting-power-display');
  const lblYield = document.getElementById('lbl-annual-yield-display');

  const stakeTokenSel = document.getElementById('liq-token') as HTMLSelectElement;
  const calculateStaking = () => {
    const val = parseFloat(stakeInput.value) || 0;
    // Slider 1-4 anos => delay_mult 5.0 (tabla MVP). Poder = stake x 5.
    if (lblPower) {
      lblPower.innerText = (val * 5).toLocaleString('en-US', { minimumFractionDigits: 2, maximumFractionDigits: 2 });
    }
    if (lblYield) {
      const tok = stakeTokenSel?.value || 'IONIC';
      const pool = poolsCache.find((p:any)=>p.token===tok);
      const apy = pool ? Number(pool.apy_30d||0) : NaN;
      lblYield.innerText = isFinite(apy) ? (val * apy / 100).toLocaleString('en-US', { minimumFractionDigits: 2, maximumFractionDigits: 2 }) : '—';
      const ySym = document.getElementById('lbl-yield-sym');
      if (ySym) ySym.innerText = tok;
    }
  };

  stakeInput?.addEventListener('input', calculateStaking);
  stakeDuration?.addEventListener('input', calculateStaking);
  stakeTokenSel?.addEventListener('change', calculateStaking);

  // Trading panel calculator
  const payInput = document.getElementById('pay-amount-input') as HTMLInputElement;
  const receiveVal = document.getElementById('lbl-receive-val');
  const tradePercentBtns = document.querySelectorAll('.trade-percent-btn');
  const coinPrices: Record<string, number> = { BTC: 58451.25, ETH: 3120.40, SOL: 142.25, ICP: 8.91, XRP: 0.62, BNB: 605.12, DOGE: 0.14, ADA: 0.45, TRX: 0.11, USDT: 1.00 };
  // Cada IP trae su Binance gratis; el servidor solo agrega medianas (ver /api/prices/report).
  const API_BASE = location.hostname === 'localhost' || location.hostname === '127.0.0.1' ? 'http://127.0.0.1:8081' : '';
  const coinChange: Record<string, number> = {};
  const BINANCE_MAP: Record<string, string> = { BTC:'BTCUSDT', ETH:'ETHUSDT', SOL:'SOLUSDT', ICP:'ICPUSDT', XRP:'XRPUSDT', BNB:'BNBUSDT', DOGE:'DOGEUSDT', ADA:'ADAUSDT', TRX:'TRXUSDT' };
  const authHeaders = (): Record<string,string> => {
    const h: Record<string,string> = { 'Content-Type': 'application/json' };
    try { const t = (wouAuth as any)?.getSessionToken?.(); if (t) h['Authorization'] = `Bearer ${t}`; } catch {}
    return h;
  };
  const isAuthed = (): boolean => { try { return !!(wouAuth as any)?.isAuthenticated?.(); } catch { return false; } };
  const fmtUsd = (v:number) => `$${Number(v||0).toLocaleString('en-US',{minimumFractionDigits:2,maximumFractionDigits:2})}`;
  const paintPriceRows = () => {
    document.querySelectorAll('.price-row').forEach(row=>{
      const sym = row.getAttribute('data-symbol')||''; const price = coinPrices[sym]; if(!price) return;
      const right = row.querySelector('.text-right'); if(!right) return;
      const priceDiv = right.querySelector('.text-xs') as HTMLElement;
      if (priceDiv) priceDiv.innerText = fmtUsd(price);
      const chg = coinChange[sym]; const chgEl = right.querySelector('span') as HTMLElement;
      if (chgEl && chg !== undefined) {
        chgEl.innerText = `${chg>=0?'+':''}${chg.toFixed(2)}%`;
        chgEl.classList.toggle('text-emerald-500', chg>=0);
        chgEl.classList.toggle('text-rose-500', chg<0);
      }
    });
  };
  const paintMarketsTable = () => {
    document.querySelectorAll('#panel-markets tbody tr').forEach(row=>{
      const sym = row.querySelector('.markets-trade-btn')?.getAttribute('data-symbol')||'';
      const price = coinPrices[sym]; if(!price) return;
      const cells = row.querySelectorAll('td.text-right.font-mono');
      if (cells[0]) cells[0].textContent = fmtUsd(price);
      const chg = coinChange[sym];
      if (cells[1] && chg !== undefined) {
        (cells[1] as HTMLElement).innerText = `${chg>=0?'+':''}${chg.toFixed(2)}%`;
        cells[1].classList.toggle('text-emerald-500', chg>=0);
        cells[1].classList.toggle('text-rose-500', chg<0);
      }
    });
  };
  const paintTradeHeader = () => {
    const title = document.getElementById('trade-chart-title');
    const price = coinPrices[currentTargetSymbol];
    if (title && price) {
      const tag = title.nextElementSibling as HTMLElement;
      const chg = coinChange[currentTargetSymbol];
      if (tag) tag.innerText = `${fmtUsd(price)} (${chg!==undefined?`${chg>=0?'+':''}${chg.toFixed(2)}%`:'—'})`;
    }
  };
  const fetchBinance = async (): Promise<Record<string,number>|null> => {
    try {
      const syms = encodeURIComponent(JSON.stringify(Object.values(BINANCE_MAP)));
      const r = await fetch(`https://api.binance.com/api/v3/ticker/24hr?symbols=${syms}`);
      if (!r.ok) return null;
      const arr: any[] = await r.json();
      const obs: Record<string,number> = {};
      arr.forEach((t:any)=>{
        const sym = Object.keys(BINANCE_MAP).find(k=>BINANCE_MAP[k]===t.symbol);
        if (!sym) return;
        const p = parseFloat(t.lastPrice); const c = parseFloat(t.priceChangePercent);
        if (isFinite(p) && p>0) { coinPrices[sym]=p; if(isFinite(c)) coinChange[sym]=c; obs[sym]=p; }
      });
      coinPrices['USDT']=1.0; coinChange['USDT']=0.0;
      return Object.keys(obs).length ? obs : null;
    } catch { return null; }
  };
  // Velas reales desde el Binance de cada IP (gratis). Sin chain, sin proxy.
  const renderChart = async () => {
    const box = document.getElementById('trade-chart'); if(!box) return;
    const sym = currentTargetSymbol;
    const pair = BINANCE_MAP[sym];
    const price = coinPrices[sym]||0;
    const frame = (inner:string, note:string) => { box.innerHTML = inner + `<div class="absolute bottom-2 left-2 text-[8px] font-mono text-zinc-400">${note}</div>`; };
    const flat = (note:string) => {
      frame(`<svg class="absolute inset-0 w-full h-full" viewBox="0 0 100 100" preserveAspectRatio="none"><line x1="0" y1="50" x2="100" y2="50" stroke="#10b981" stroke-width="0.6"/></svg>`, note);
    };
    if (!pair) { flat(`INTERNAL PRICE ${fmtUsd(price)} · NO MARKET HISTORY`); return; }
    try {
      const r = await fetch(`https://api.binance.com/api/v3/klines?symbol=${pair}&interval=15m&limit=96`);
      if (!r.ok) throw 0;
      const k:any[] = await r.json();
      if (!k.length) throw 0;
      let hi = -Infinity, lo = Infinity;
      const rows = k.map(c=>[parseFloat(c[1]),parseFloat(c[2]),parseFloat(c[3]),parseFloat(c[4])]);
      rows.forEach(rw=>{ hi=Math.max(hi,rw[1]); lo=Math.min(lo,rw[2]); });
      if (!(hi>lo)) throw 0;
      const n = rows.length; const w = 100/n; const bw = Math.max(0.3, w*0.55);
      const y = (p:number) => 96 - ((p-lo)/(hi-lo))*92;
      let svg = `<svg class="absolute inset-0 w-full h-full" viewBox="0 0 100 100" preserveAspectRatio="none">`;
      rows.forEach((rw,i)=>{
        const o=rw[0], h=rw[1], l=rw[2], c=rw[3];
        const col = c>=o?'#10b981':'#ef4444';
        const x = i*w + w/2;
        svg += `<line x1="${x.toFixed(2)}" y1="${y(h).toFixed(2)}" x2="${x.toFixed(2)}" y2="${y(l).toFixed(2)}" stroke="${col}" stroke-width="0.25"/>`;
        const top = y(Math.max(o,c)), bot = y(Math.min(o,c));
        svg += `<rect x="${(x-bw/2).toFixed(2)}" y="${top.toFixed(2)}" width="${bw.toFixed(2)}" height="${Math.max(0.6,bot-top).toFixed(2)}" fill="${col}"/>`;
      });
      svg += `</svg>`;
      frame(svg, `${sym}/USDT 15m · BINANCE`);
