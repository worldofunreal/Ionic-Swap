  const showErr=(m:string, isOk=false)=>{ const el=isOk?authMsg:errorMsg; const banner=isOk?authMsg?.parentElement:errorBanner; if(el&&banner){ el.textContent=m; banner.classList.remove('hidden'); if(isOk) { (banner as HTMLElement).className='p-2 rounded-xl bg-emerald-500/10 border border-emerald-500/30 text-emerald-400 text-xs text-center'; } } if(!isOk && errorBanner&&errorMsg){ errorMsg.textContent=m; errorBanner.classList.remove('hidden'); }};
