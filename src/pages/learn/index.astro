---
import ContentLayout from '../../layouts/ContentLayout.astro';
---

<ContentLayout title={"Learn DeFi - Ionic Swap"} description={"Master the fundamentals of decentralized finance, token standards, and cross-chain swapping. Start your DeFi journey today."} canonical={"https://ionicswap.com/learn"}>
  <div class="min-h-screen bg-zinc-50 dark:bg-zinc-900">
      <div class="max-w-6xl mx-auto py-8 px-4 sm:px-6 lg:px-8">
        <!-- Page Header -->
        <div class="text-center mb-12">
          <h1 class="text-4xl font-bold text-zinc-900 dark:text-white mb-4">
            Learn DeFi
          </h1>
          <p class="text-xl text-zinc-600 dark:text-zinc-300 max-w-3xl mx-auto">
            Master the fundamentals of decentralized finance, token standards, and
            cross-chain swapping. Start your journey into the future of finance.
          </p>
        </div>

        <!-- Hero Section -->
        <div class="rounded-lg p-8 mb-12 text-white bg-gradient-to-r from-emerald-600 to-emerald-800"
        >
          <div class="max-w-4xl mx-auto text-center">
            <h2 class="text-3xl font-bold mb-4">
              Your Gateway to DeFi Education
            </h2>
            <p class="text-lg opacity-90 mb-6">
              From basic concepts to advanced trading strategies, learn everything
              you need to know about decentralized finance and cross-chain token
              swapping.
            </p>
            <div class="flex flex-wrap justify-center gap-4">
              <div
                class="flex items-center gap-2 bg-zinc-50/20 rounded-full px-4 py-2"
              >
                <span class="w-5 h-5 inline-flex items-center justify-center leading-none" aria-hidden="true">🎓</span>
                <span class="text-sm font-medium">Beginner Friendly</span>
              </div>
              <div
                class="flex items-center gap-2 bg-zinc-50/20 rounded-full px-4 py-2"
              >
                <span class="w-5 h-5 inline-flex items-center justify-center leading-none" aria-hidden="true">⏱️</span>
                <span class="text-sm font-medium">5-10 min reads</span>
              </div>
              <div
                class="flex items-center gap-2 bg-zinc-50/20 rounded-full px-4 py-2"
              >
                <span class="w-5 h-5 inline-flex items-center justify-center leading-none" aria-hidden="true">🛡️</span>
                <span class="text-sm font-medium">Expert Reviewed</span>
              </div>
            </div>
          </div>
        </div>

        <!-- Learning Paths -->
        <div class="mb-12">
          <h2
            class="text-2xl font-bold text-zinc-900 dark:text-white mb-8 text-center"
          >
            Choose Your Learning Path
          </h2>

          <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6">
            <!-- Beginner Path -->
            <div
              class="bg-zinc-50 dark:bg-neutral-900 rounded-lg shadow-sm p-6 border border-gray-200 dark:border-gray-700"
            >
              <div class="flex items-center gap-3 mb-4">
                <div
                  class="w-12 h-12 rounded-full bg-green-100 dark:bg-green-900 flex items-center justify-center"
                >
                  <span class="w-6 h-6 text-green-600 dark:text-green-400 inline-flex items-center justify-center leading-none" aria-hidden="true">🎓</span>
                </div>
                <div>
                  <h3 class="text-lg font-semibold text-zinc-900 dark:text-white">
                    Beginner
                  </h3>
                  <p class="text-sm text-zinc-600 dark:text-zinc-300">
                    Start here if you're new to DeFi
                  </p>
                </div>
              </div>
              <p class="text-zinc-600 dark:text-zinc-300 mb-4">
                Learn the basics of tokens, blockchain standards, and how DeFi
                works.
              </p>
              <div class="space-y-2">
                <a
                  href="/learn/what-are-tokens"
                  class="block p-3 rounded-lg hover:bg-gray-50 dark:hover:bg-gray-800 transition-colors"
                >
                  <div class="flex items-center gap-3">
                    <span class="w-5 h-5 text-emerald-600 dark:text-emerald-400 inline-flex items-center justify-center leading-none" aria-hidden="true">💲</span>
                    <span class="text-zinc-700 dark:text-zinc-300"
                      >What are Tokens?</span
                    >
                  </div>
                </a>
                <a
                  href="/learn/defi-basics"
                  class="block p-3 rounded-lg hover:bg-gray-50 dark:hover:bg-gray-800 transition-colors"
                >
                  <div class="flex items-center gap-3">
                    <span class="w-5 h-5 text-emerald-600 dark:text-emerald-400 inline-flex items-center justify-center leading-none" aria-hidden="true">💵</span>
                    <span class="text-zinc-700 dark:text-zinc-300"
                      >DeFi Basics</span
                    >
                  </div>
                </a>
              </div>
            </div>

            <!-- Intermediate Path -->
            <div
              class="bg-zinc-50 dark:bg-neutral-900 rounded-lg shadow-sm p-6 border border-gray-200 dark:border-gray-700"
            >
              <div class="flex items-center gap-3 mb-4">
                <div
                  class="w-12 h-12 rounded-full bg-blue-100 dark:bg-blue-900 flex items-center justify-center"
                >
                  <span class="w-6 h-6 text-blue-600 dark:text-blue-400 inline-flex items-center justify-center leading-none" aria-hidden="true">⚙️</span>
                </div>
                <div>
                  <h3 class="text-lg font-semibold text-zinc-900 dark:text-white">
                    Intermediate
                  </h3>
                  <p class="text-sm text-zinc-600 dark:text-zinc-300">
                    Understand the technical details
                  </p>
                </div>
              </div>
              <p class="text-zinc-600 dark:text-zinc-300 mb-4">
                Dive deeper into token standards and cross-chain technology.
              </p>
              <div class="space-y-2">
                <a
                  href="/learn/token-standards"
                  class="block p-3 rounded-lg hover:bg-gray-50 dark:hover:bg-gray-800 transition-colors"
                >
                  <div class="flex items-center gap-3">
                    <span class="w-5 h-5 text-emerald-600 dark:text-emerald-400 inline-flex items-center justify-center leading-none" aria-hidden="true">⚙️</span>
                    <span class="text-zinc-700 dark:text-zinc-300"
                      >Token Standards</span
                    >
                  </div>
                </a>
                <a
                  href="/learn/cross-chain-swapping"
                  class="block p-3 rounded-lg hover:bg-gray-50 dark:hover:bg-gray-800 transition-colors"
                >
                  <div class="flex items-center gap-3">
                    <span class="w-5 h-5 text-emerald-600 dark:text-emerald-400 inline-flex items-center justify-center leading-none" aria-hidden="true">🔄</span>
                    <span class="text-zinc-700 dark:text-zinc-300"
                      >Cross-Chain Swapping</span
                    >
                  </div>
                </a>
              </div>
            </div>

            <!-- Advanced Path -->
            <div
              class="bg-zinc-50 dark:bg-neutral-900 rounded-lg shadow-sm p-6 border border-gray-200 dark:border-gray-700"
            >
              <div class="flex items-center gap-3 mb-4">
                <div
                  class="w-12 h-12 rounded-full bg-purple-100 dark:bg-purple-900 flex items-center justify-center"
                >
                  <span class="w-6 h-6 text-purple-600 dark:text-purple-400 inline-flex items-center justify-center leading-none" aria-hidden="true">⚡</span>
                </div>
                <div>
                  <h3 class="text-lg font-semibold text-zinc-900 dark:text-white">
                    Advanced
                  </h3>
                  <p class="text-sm text-zinc-600 dark:text-zinc-300">
                    Master cutting-edge features
                  </p>
                </div>
              </div>
              <p class="text-zinc-600 dark:text-zinc-300 mb-4">
                Learn about gasless transactions and advanced DeFi concepts.
              </p>
              <div class="space-y-2">
                <a
                  href="/learn/gasless-transactions"
                  class="block p-3 rounded-lg hover:bg-gray-50 dark:hover:bg-gray-800 transition-colors"
                >
                  <div class="flex items-center gap-3">
                    <span class="w-5 h-5 text-emerald-600 dark:text-emerald-400 inline-flex items-center justify-center leading-none" aria-hidden="true">⚡</span>
                    <span class="text-zinc-700 dark:text-zinc-300"
                      >Gasless Transactions</span
                    >
                  </div>
                </a>
              </div>
            </div>
          </div>
        </div>

        <!-- All Articles Grid -->
        <div class="mb-12">
          <h2
            class="text-2xl font-bold text-zinc-900 dark:text-white mb-8 text-center"
          >
            All Articles
          </h2>

                    <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6">
          <a
            href="/learn/what-are-tokens"
            class="group bg-zinc-50 dark:bg-neutral-900 rounded-lg shadow-sm p-6 border border-gray-200 dark:border-gray-700 hover:shadow-md transition-all duration-200 hover:scale-105"
          >
            <div class="flex items-center gap-3 mb-4">
              <div class="w-12 h-12 rounded-full bg-emerald-100 dark:bg-emerald-900 flex items-center justify-center">
                <span class="text-xl inline-flex items-center justify-center leading-none" aria-hidden="true">💲</span>
              </div>
              <div class="flex-1">
                <h3 class="text-lg font-semibold text-zinc-900 dark:text-white group-hover:text-emerald-600 dark:group-hover:text-emerald-400 transition-colors">
                  What are Tokens?
                </h3>
                <p class="text-sm text-zinc-600 dark:text-zinc-300">Beginner</p>
              </div>
            </div>
            <p class="text-zinc-600 dark:text-zinc-300 mb-4 line-clamp-2">Learn about different types of tokens, their standards, and how they work across blockchains.</p>
            <div class="flex items-center justify-between">
              <div class="flex items-center gap-2 text-sm text-zinc-500 dark:text-zinc-400">
                <span class="w-4 h-4 inline-flex items-center justify-center leading-none" aria-hidden="true">⏱️</span>
                <span>5 min read</span>
              </div>
              <span class="w-5 h-5 text-emerald-600 dark:text-emerald-400 group-hover:translate-x-1 transition-transform inline-flex items-center justify-center leading-none" aria-hidden="true">→</span>
            </div>
          </a>
          <a
            href="/learn/defi-basics"
            class="group bg-zinc-50 dark:bg-neutral-900 rounded-lg shadow-sm p-6 border border-gray-200 dark:border-gray-700 hover:shadow-md transition-all duration-200 hover:scale-105"
          >
            <div class="flex items-center gap-3 mb-4">
              <div class="w-12 h-12 rounded-full bg-emerald-100 dark:bg-emerald-900 flex items-center justify-center">
                <span class="text-xl inline-flex items-center justify-center leading-none" aria-hidden="true">💵</span>
              </div>
              <div class="flex-1">
                <h3 class="text-lg font-semibold text-zinc-900 dark:text-white group-hover:text-emerald-600 dark:group-hover:text-emerald-400 transition-colors">
                  DeFi Basics
                </h3>
                <p class="text-sm text-zinc-600 dark:text-zinc-300">Beginner</p>
              </div>
            </div>
            <p class="text-zinc-600 dark:text-zinc-300 mb-4 line-clamp-2">Get started with DeFi concepts, liquidity, and decentralized trading protocols.</p>
            <div class="flex items-center justify-between">
              <div class="flex items-center gap-2 text-sm text-zinc-500 dark:text-zinc-400">
                <span class="w-4 h-4 inline-flex items-center justify-center leading-none" aria-hidden="true">⏱️</span>
                <span>8 min read</span>
              </div>
              <span class="w-5 h-5 text-emerald-600 dark:text-emerald-400 group-hover:translate-x-1 transition-transform inline-flex items-center justify-center leading-none" aria-hidden="true">→</span>
            </div>
          </a>
          <a
            href="/learn/token-standards"
            class="group bg-zinc-50 dark:bg-neutral-900 rounded-lg shadow-sm p-6 border border-gray-200 dark:border-gray-700 hover:shadow-md transition-all duration-200 hover:scale-105"
          >
            <div class="flex items-center gap-3 mb-4">
              <div class="w-12 h-12 rounded-full bg-emerald-100 dark:bg-emerald-900 flex items-center justify-center">
                <span class="text-xl inline-flex items-center justify-center leading-none" aria-hidden="true">⚙️</span>
              </div>
              <div class="flex-1">
                <h3 class="text-lg font-semibold text-zinc-900 dark:text-white group-hover:text-emerald-600 dark:group-hover:text-emerald-400 transition-colors">
                  Token Standards
                </h3>
                <p class="text-sm text-zinc-600 dark:text-zinc-300">Intermediate</p>
              </div>
            </div>
            <p class="text-zinc-600 dark:text-zinc-300 mb-4 line-clamp-2">Explore the different token standards used on Ethereum, Solana, and Internet Computer.</p>
            <div class="flex items-center justify-between">
              <div class="flex items-center gap-2 text-sm text-zinc-500 dark:text-zinc-400">
                <span class="w-4 h-4 inline-flex items-center justify-center leading-none" aria-hidden="true">⏱️</span>
                <span>10 min read</span>
              </div>
              <span class="w-5 h-5 text-emerald-600 dark:text-emerald-400 group-hover:translate-x-1 transition-transform inline-flex items-center justify-center leading-none" aria-hidden="true">→</span>
            </div>
          </a>
          <a
            href="/learn/cross-chain-swapping"
            class="group bg-zinc-50 dark:bg-neutral-900 rounded-lg shadow-sm p-6 border border-gray-200 dark:border-gray-700 hover:shadow-md transition-all duration-200 hover:scale-105"
          >
            <div class="flex items-center gap-3 mb-4">
              <div class="w-12 h-12 rounded-full bg-emerald-100 dark:bg-emerald-900 flex items-center justify-center">
                <span class="text-xl inline-flex items-center justify-center leading-none" aria-hidden="true">🔄</span>
              </div>
              <div class="flex-1">
                <h3 class="text-lg font-semibold text-zinc-900 dark:text-white group-hover:text-emerald-600 dark:group-hover:text-emerald-400 transition-colors">
                  Cross-Chain Swapping
                </h3>
                <p class="text-sm text-zinc-600 dark:text-zinc-300">Intermediate</p>
              </div>
            </div>
            <p class="text-zinc-600 dark:text-zinc-300 mb-4 line-clamp-2">Discover how to swap tokens between different blockchains seamlessly and securely.</p>
            <div class="flex items-center justify-between">
              <div class="flex items-center gap-2 text-sm text-zinc-500 dark:text-zinc-400">
                <span class="w-4 h-4 inline-flex items-center justify-center leading-none" aria-hidden="true">⏱️</span>
                <span>7 min read</span>
              </div>
              <span class="w-5 h-5 text-emerald-600 dark:text-emerald-400 group-hover:translate-x-1 transition-transform inline-flex items-center justify-center leading-none" aria-hidden="true">→</span>
            </div>
          </a>
          <a
            href="/learn/gasless-transactions"
            class="group bg-zinc-50 dark:bg-neutral-900 rounded-lg shadow-sm p-6 border border-gray-200 dark:border-gray-700 hover:shadow-md transition-all duration-200 hover:scale-105"
          >
            <div class="flex items-center gap-3 mb-4">
              <div class="w-12 h-12 rounded-full bg-emerald-100 dark:bg-emerald-900 flex items-center justify-center">
                <span class="text-xl inline-flex items-center justify-center leading-none" aria-hidden="true">⚡</span>
              </div>
              <div class="flex-1">
                <h3 class="text-lg font-semibold text-zinc-900 dark:text-white group-hover:text-emerald-600 dark:group-hover:text-emerald-400 transition-colors">
                  Gasless Transactions
                </h3>
                <p class="text-sm text-zinc-600 dark:text-zinc-300">Advanced</p>
              </div>
            </div>
            <p class="text-zinc-600 dark:text-zinc-300 mb-4 line-clamp-2">Learn about gasless transaction technology and how it makes swapping more accessible.</p>
            <div class="flex items-center justify-between">
              <div class="flex items-center gap-2 text-sm text-zinc-500 dark:text-zinc-400">
                <span class="w-4 h-4 inline-flex items-center justify-center leading-none" aria-hidden="true">⏱️</span>
                <span>9 min read</span>
              </div>
              <span class="w-5 h-5 text-emerald-600 dark:text-emerald-400 group-hover:translate-x-1 transition-transform inline-flex items-center justify-center leading-none" aria-hidden="true">→</span>
            </div>
          </a>
          </div>
        </div>

        <!-- Call to Action -->
        <div class="text-center">
          <div
            class="bg-zinc-50 dark:bg-neutral-900 rounded-lg shadow-sm p-8 border border-gray-200 dark:border-gray-700"
          >
            <h2 class="text-2xl font-bold text-zinc-900 dark:text-white mb-4">
              Ready to Start Swapping?
            </h2>
            <p class="text-zinc-600 dark:text-zinc-300 mb-6 max-w-2xl mx-auto">
              Now that you understand the basics, try swapping tokens across
              different blockchain networks with our gasless transaction system.
            </p>
            <a
              href="/" class="inline-flex items-center gap-2 px-6 py-3 rounded-lg font-semibold text-white transition-colors bg-emerald-600 hover:bg-emerald-700"
            >
              <span class="w-5 h-5 inline-flex items-center justify-center leading-none" aria-hidden="true">🔄</span>
              Start Swapping
            </a>
          </div>
        </div>
      </div>
    </div>
</ContentLayout>
