<script>
  // ponytail: unified gray/zinc dashboard controller in under 115 lines
  const navItems = document.querySelectorAll('.nav-item');
  const modules = document.querySelectorAll('.module-view');

  // Router mechanism
  navItems.forEach(item => {
    item.addEventListener('click', () => {
      const target = item.getAttribute('data-target');

      // Update sidebar states
      navItems.forEach(nav => {
        nav.classList.remove('text-emerald-500', 'bg-emerald-500/10', 'dark:bg-emerald-500/5', 'border', 'border-emerald-400/20');
        nav.classList.add('text-zinc-500', 'dark:text-zinc-400');
      });
      item.classList.add('text-emerald-500', 'bg-emerald-500/10', 'dark:bg-emerald-500/5', 'border', 'border-emerald-400/20');
      item.classList.remove('text-zinc-500', 'dark:text-zinc-400');

      // Update active panel views
      modules.forEach(mod => {
        mod.classList.remove('active');
      });
      const targetPanel = document.getElementById(`panel-${target}`);
      if (targetPanel) {
        targetPanel.classList.add('active');
      }
    });
  });

  // Slide carousel controls
  let activeSlide = 0;
  const carouselTrack = document.getElementById('carousel-track');
  const dots = document.querySelectorAll('.carousel-dot');

  const updateCarousel = (slideIndex: number) => {
    if (carouselTrack) {
      carouselTrack.style.transform = `translateX(-${slideIndex * 100}%)`;
      dots.forEach((dot, idx) => {
        if (idx === slideIndex) {
          dot.classList.add('bg-emerald-500');
          dot.classList.remove('bg-zinc-300', 'dark:bg-zinc-700');
        } else {
          dot.classList.remove('bg-emerald-500');
          dot.classList.add('bg-zinc-300', 'dark:bg-zinc-700');
        }
      });
      activeSlide = slideIndex;
    }
  };

  dots.forEach(dot => {
    dot.addEventListener('click', () => {
      const slide = parseInt(dot.getAttribute('data-slide') || '0');
      updateCarousel(slide);
    });
  });

  // Auto scroll carousel every 6 seconds
  setInterval(() => {
    const nextSlide = (activeSlide + 1) % 2; // We have 2 slides
    updateCarousel(nextSlide);
  }, 6000);

  // General notification triggers
  const toast = document.getElementById('toast');
  const toastMsg = document.getElementById('toast-message');
  let toastTimeout: NodeJS.Timeout;

  const showNotification = (message: string) => {
    if (toast && toastMsg) {
      toastMsg.innerText = message;
      toast.classList.remove('hidden');
      toast.classList.add('flex');
      clearTimeout(toastTimeout);
      toastTimeout = setTimeout(() => {
        toast.classList.add('hidden');
        toast.classList.remove('flex');
      }, 2500);
    }
  };

  document.querySelectorAll('.address-copy-btn').forEach(btn => {
    btn.addEventListener('click', (e) => {
      const addr = btn.getAttribute('data-address') || '';
      navigator.clipboard.writeText(addr).then(() => {
        showNotification(`Copied address: ${addr.slice(0, 10)}...`);
      });
      e.stopPropagation();
    });
  });

  // Staking multiplier calculations
  const stakeInput = document.getElementById('liq-stake-input') as HTMLInputElement;
  const stakeDuration = document.getElementById('liq-stake-duration') as HTMLInputElement;
  const lblPower = document.getElementById('lbl-voting-power-display');
  const lblYield = document.getElementById('lbl-annual-yield-display');

  const calculateStaking = () => {
    const val = parseFloat(stakeInput.value) || 0;
    const dur = parseFloat(stakeDuration.value) || 1;

    if (lblPower) {
      lblPower.innerText = (val * dur).toLocaleString('en-US', { minimumFractionDigits: 2, maximumFractionDigits: 2 });
    }
    if (lblYield) {
      lblYield.innerText = (val * dur * 0.0625).toLocaleString('en-US', { minimumFractionDigits: 2, maximumFractionDigits: 2 });
    }
  };

  stakeInput?.addEventListener('input', calculateStaking);
  stakeDuration?.addEventListener('input', calculateStaking);

  // Trading panel calculator
  const payInput = document.getElementById('pay-amount-input') as HTMLInputElement;
  const receiveVal = document.getElementById('lbl-receive-val');
  const tradePercentBtns = document.querySelectorAll('.trade-percent-btn');
  const coinPrices: Record<string, number> = { BTC: 58451.25, ETH: 3120.40, SOL: 142.25, ICP: 8.91, XRP: 0.62, BNB: 605.12, DOGE: 0.14, ADA: 0.45, TRX: 0.11, USDT: 1.00 };
  // free oracle: try Rust server first, fallback to static
  const API_BASE = location.hostname === 'localhost' || location.hostname === '127.0.0.1' ? 'http://127.0.0.1:8081' : '';
  const refreshFromServer = async () => {
    try { const r = await fetch(`${API_BASE}/api/prices`); if (!r.ok) return; const arr: any[] = await r.json();
      arr.forEach((p:any)=>{ if(p.symbol && p.price) coinPrices[p.symbol]=p.price; const el = document.querySelector(`[data-symbol="${p.symbol}"]`); if(el){ const priceEl = el.querySelector('.font-mono .text-xs') || el.nextElementSibling; }});
      updateTradeCalculator();
      // update price rows text live (ponytail: direct DOM, no framework)
      document.querySelectorAll('.price-row').forEach(row=>{
        const sym=row.getAttribute('data-symbol')||''; const price=coinPrices[sym]; if(!price) return;
        const priceDiv=row.querySelector('.text-right .text-xs') as HTMLElement; if(priceDiv) priceDiv.innerText=`$${price.toLocaleString()}`;
      });
    } catch {}
  };
  refreshFromServer(); setInterval(refreshFromServer, 30000);

  let currentTargetSymbol = 'BTC';

  const updateTradeCalculator = () => {
    const val = parseFloat(payInput.value) || 0;
    const price = coinPrices[currentTargetSymbol] || 58451.25;
    if (receiveVal) {
      receiveVal.innerText = (val / price).toFixed(6);
    }
  };

  payInput?.addEventListener('input', updateTradeCalculator);

  tradePercentBtns.forEach(btn => {
    btn.addEventListener('click', () => {
      const percent = parseFloat(btn.getAttribute('data-val') || '0');
      const maxUSDTBalance = 1250;
      payInput.value = ((maxUSDTBalance * percent) / 100).toFixed(2);
      updateTradeCalculator();
    });
  });

  // --- LOCAL PERSISTENCE (ponytail: single localStorage, no custodio) ---
  const LS_KEY = 'ionic_swap_v1';
  type Tx = { id:string, from:string, to:string, amount:number, receive:number, price:number, ts:number };
  const defaultBalances: Record<string, number> = { USDT:1250, BTC:1.45, ETH:8.5, SOL:52.4, XRP:1200, BNB:3.2, DOGE:5000, ADA:2400, TRX:8000, ICP:180 };
  const loadState = () => {
    try { return JSON.parse(localStorage.getItem(LS_KEY) || 'null') || { balances:{...defaultBalances}, txs:[] as Tx[], stakes:[] as any[] }; } catch { return { balances:{...defaultBalances}, txs:[], stakes:[] }; }
  };
  let state = loadState();
  const saveState = () => localStorage.setItem(LS_KEY, JSON.stringify(state));
  const headerSearch = document.querySelector('header input[placeholder*="Search"]') as HTMLInputElement;
  headerSearch?.addEventListener('input', () => {
    const q = headerSearch.value.toLowerCase().trim();
    document.querySelectorAll('.price-row').forEach(row => {
      const sym = (row.getAttribute('data-symbol')||'').toLowerCase();
      const txt = row.textContent?.toLowerCase()||'';
      (row as HTMLElement).style.display = !q || sym.includes(q) || txt.includes(q) ? '' : 'none';
    });
    document.querySelectorAll('#panel-markets tbody tr').forEach(row => {
      const sym = (row.querySelector('[data-symbol]')?.getAttribute('data-symbol')||'').toLowerCase();
      const txt = row.textContent?.toLowerCase()||'';
      (row as HTMLElement).style.display = !q || sym.includes(q) || txt.includes(q) ? '' : 'none';
    });
    document.querySelectorAll('#panel-wallet .p-3\\.5').forEach(el => {
      const txt = el.textContent?.toLowerCase()||'';
      (el as HTMLElement).style.display = !q || txt.includes(q) ? '' : 'none';
    });
  });
  const ensureTxHistory = () => {
    const tradeLeft = document.querySelector('#panel-trade .lg\\:col-span-3');
    if (!tradeLeft || document.getElementById('trade-tx-history')) return;
    const box = document.createElement('div');
    box.id = 'trade-tx-history';
    box.className = 'mt-4 bg-zinc-50 dark:bg-zinc-800 border border-zinc-200 dark:border-zinc-850 rounded-2xl p-4 max-h-48 overflow-y-auto scrollbar-thin';
    box.innerHTML = '<h4 class="text-xs font-bold text-zinc-900 dark:text-white mb-2 font-mono">TRANSACTION_HISTORY (local)</h4><div id="tx-list" class="space-y-1 font-mono text-[10px]"></div>';
    tradeLeft.appendChild(box);
  };
  const renderTxs = () => {
    ensureTxHistory();
    const list = document.getElementById('tx-list');
    if (!list) return;
    if (state.txs.length === 0) { list.innerHTML = '<span class="text-zinc-500">No swaps yet — local only, Rust canister later.</span>'; return; }
    list.innerHTML = state.txs.slice(-10).reverse().map(t => `<div class="flex justify-between p-2 bg-zinc-100 dark:bg-zinc-900 rounded border border-zinc-200 dark:border-zinc-700"><span>${t.from} → ${t.to} ${t.receive.toFixed(6)}</span><span class="text-zinc-500">${new Date(t.ts).toLocaleTimeString()}</span></div>`).join('');
  };
  renderTxs();

  // Actions trigger triggers (try Rust server first, fallback local)
  document.getElementById('btn-submit-swap')?.addEventListener('click', async () => {
    const amt = parseFloat((document.getElementById('pay-amount-input') as HTMLInputElement)?.value || '0');
    if (!amt || amt <= 0) { showNotification("Enter amount"); return; }
    try {
      const r = await fetch(`${API_BASE}/api/swap`, {method:'POST', headers:{'Content-Type':'application/json'}, body: JSON.stringify({from:'USDT', to: currentTargetSymbol, amount: amt})});
      if (r.ok) { const j:any = await r.json(); state.txs.push({ id: j.tx_id, from:'USDT', to: j.to, amount: j.amount, receive: j.receive, price: j.price, ts: Date.now() }); saveState(); renderTxs(); showNotification(`Swap ${j.amount} USDT → ${j.receive.toFixed(6)} ${j.to} (Rust free ${j.fee.toFixed(4)} fee)`); return; }
    } catch {}
    if ((state.balances['USDT']||0) < amt) { showNotification("Insufficient USDT (local)"); return; }
    const price = coinPrices[currentTargetSymbol] || 1;
    const receive = amt / price;
    state.balances['USDT'] -= amt;
    state.balances[currentTargetSymbol] = (state.balances[currentTargetSymbol]||0) + receive;
    state.txs.push({ id: Date.now().toString(), from:'USDT', to: currentTargetSymbol, amount: amt, receive, price, ts: Date.now() });
    saveState(); renderTxs();
    showNotification(`Swap ${amt} USDT → ${receive.toFixed(6)} ${currentTargetSymbol} (local fallback)`);
  });

  document.getElementById('btn-approve-stake')?.addEventListener('click', async () => {
    const amt = parseFloat((document.getElementById('liq-stake-input') as HTMLInputElement)?.value || '0');
    const dur = parseFloat((document.getElementById('liq-stake-duration') as HTMLInputElement)?.value || '1');
    if (!amt || amt <= 0) { showNotification("Enter stake amount"); return; }
    try {
      const r = await fetch(`${API_BASE}/api/stake`, {method:'POST', headers:{'Content-Type':'application/json'}, body: JSON.stringify({token:'IONIC', amount: amt, dissolve_delay_secs: dur*31536000})});
      if (r.ok) { const j:any = await r.json(); state.stakes.push({ id: j.position_id, amount: j.amount, duration: dur, voting_power: j.voting_power, ts: Date.now() }); saveState(); showNotification(`Staking ${j.amount} IONIC vp ${j.voting_power.toFixed(0)} apy ${(j.apy*100).toFixed(1)}% (Rust)`); return; }
    } catch {}
    state.stakes.push({ id: Date.now().toString(), amount: amt, duration: dur, ts: Date.now() });
    saveState();
    showNotification(`Staking ${amt} IONIC locked ${dur}y (local fallback)`);
  });

  // Action links routers
  document.querySelectorAll('.price-row, .markets-trade-btn, .quick-trade-btn').forEach(btn => {
    btn.addEventListener('click', (e) => {
      const row = btn.closest('tr') || btn.closest('.price-row');
      if (row) {
        const symbol = row.getAttribute('data-symbol') || row.querySelector('[data-symbol]')?.getAttribute('data-symbol') || 'BTC';
        currentTargetSymbol = symbol;

        // Update trade panel details
        const headerTitle = document.getElementById('trade-chart-title');
        if (headerTitle) headerTitle.innerText = `${symbol}/USDT`;

        const receiveSym = document.getElementById('lbl-receive-sym');
        if (receiveSym) receiveSym.innerText = symbol;

        updateTradeCalculator();

        // Router to trade tab
        const tradeNav = document.querySelector('button[data-target="trade"]') as HTMLButtonElement;
        tradeNav?.click();
      }
      e.stopPropagation();
    });
  });

  document.querySelectorAll('.nav-to-trade').forEach(btn => {
    btn.addEventListener('click', () => {
      const tradeNav = document.querySelector('button[data-target="trade"]') as HTMLButtonElement;
      tradeNav?.click();
    });
  });

  // --- WOU-ID proper (mirrors worldofunreal.com/src/scripts/wou-auth.ts, no fake guest) ---
  import { wouAuth } from '../scripts/wou-auth';
  const signinBtn = document.getElementById('wou-signin-btn');
  const userPill = document.getElementById('wou-user-pill');
  const userBtn = document.getElementById('wou-user-btn');
  const userDropdown = document.getElementById('wou-user-dropdown');
  const userName = document.getElementById('wou-user-name');
  const userHandle = document.getElementById('wou-user-handle');
  const dropdownName = document.getElementById('wou-dropdown-name');
  const dropdownHandle = document.getElementById('wou-dropdown-handle');
  const dropdownEmail = document.getElementById('wou-dropdown-email');
  const avatars = [document.getElementById('wou-user-avatar'), document.getElementById('wou-dropdown-avatar')];
  // legacy cleanup: remove old wou_session fake key once
  localStorage.removeItem('wou_session');
  const updateAuthUI = (detail:any) => {
    if (detail?.authenticated && detail?.user) {
      const u = detail.user;
      signinBtn?.classList.add('hidden'); userPill?.classList.remove('hidden');
      const name = u.display_name || u.username || 'Player';
      const handle = u.username ? `@${u.username}` : '@player';
      if (userName) userName.textContent = name;
      if (userHandle) userHandle.textContent = handle;
      if (dropdownName) dropdownName.textContent = name;
      if (dropdownHandle) dropdownHandle.textContent = handle;
      if (dropdownEmail) dropdownEmail.textContent = u.email || '';
      const emoji = (u.profile?.custom_attributes as any)?.animal_emoji || (name.slice(0,2).toUpperCase());
      avatars.forEach(a=>{ if(!a) return; if (u.profile?.avatar_url) a.innerHTML=`<img src="${u.profile.avatar_url}" class="w-full h-full object-cover rounded-full"/>`; else a.textContent=emoji; });
    } else {
      signinBtn?.classList.remove('hidden'); userPill?.classList.add('hidden'); userDropdown?.classList.add('hidden');
    }
  };
  window.addEventListener('wou:auth-state-change', (e:any)=> updateAuthUI(e.detail));
  if (wouAuth.isAuthenticated()) updateAuthUI({authenticated:true, user:wouAuth.getUser()});
  signinBtn?.addEventListener('click', ()=> wouAuth.openModal());
  userBtn?.addEventListener('click', (e)=>{ e.stopPropagation(); userDropdown?.classList.toggle('hidden'); });
  document.addEventListener('click', (e)=>{ if (!userDropdown?.contains(e.target as Node) && !userBtn?.contains(e.target as Node)) userDropdown?.classList.add('hidden'); });
  document.getElementById('wou-logout-btn')?.addEventListener('click', ()=>{ wouAuth.logout(); showNotification('Logged out'); });
  document.getElementById('copy-evm-btn')?.addEventListener('click', ()=>{ const a=wouAuth.getUser()?.embedded_wallets?.evm_address; if(a){ navigator.clipboard.writeText(a); showNotification('Copied EVM'); }});
  document.getElementById('copy-sol-btn')?.addEventListener('click', ()=>{ const a=wouAuth.getUser()?.embedded_wallets?.solana_address; if(a){ navigator.clipboard.writeText(a); showNotification('Copied SOL'); }});
  document.getElementById('copy-icp-btn')?.addEventListener('click', ()=>{ const a=wouAuth.getUser()?.embedded_wallets?.icp_principal; if(a){ navigator.clipboard.writeText(a); showNotification('Copied ICP'); }});
  // modal wiring (tabs + OTP 6-digit + social + web3)
  const modal = document.getElementById('wou-auth-modal');
  const closeBtn = document.getElementById('modal-close-btn');
  const errorBanner = document.getElementById('modal-error');
  const errorMsg = document.getElementById('modal-error-msg');
  const titleEl = document.getElementById('modal-title');
  const subEl = document.getElementById('modal-subtitle');
  const tabEmail = document.getElementById('tab-btn-email');
  const tabSocial = document.getElementById('tab-btn-social');
  const tabWeb3 = document.getElementById('tab-btn-web3');
  const cEmail = document.getElementById('tab-content-email');
  const cSocial = document.getElementById('tab-content-social');
  const cWeb3 = document.getElementById('tab-content-web3');
  const formReq = document.getElementById('form-request-otp') as HTMLFormElement;
  const formVer = document.getElementById('form-verify-otp') as HTMLFormElement;
  const inputEmail = document.getElementById('wou-input-email') as HTMLInputElement;
  const otpDigits = document.querySelectorAll('.otp-digit') as NodeListOf<HTMLInputElement>;
  let currentEmail='';
  const showErr=(m:string)=>{ if(errorBanner&&errorMsg){ errorMsg.textContent=m; errorBanner.classList.remove('hidden'); }};
  const hideErr=()=> errorBanner?.classList.add('hidden');
  const setTab=(t:'email'|'social'|'web3')=>{
    hideErr();
    [tabEmail,tabSocial,tabWeb3].forEach(b=> b?.setAttribute('class','flex-1 py-2 text-xs font-semibold rounded-xl text-zinc-400 hover:text-white transition'));
    cEmail?.classList.add('hidden'); cSocial?.classList.add('hidden'); cWeb3?.classList.add('hidden');
    if(t==='email'){ tabEmail?.setAttribute('class','flex-1 py-2 text-xs font-semibold rounded-xl bg-white text-zinc-950'); cEmail?.classList.remove('hidden'); }
    else if(t==='social'){ tabSocial?.setAttribute('class','flex-1 py-2 text-xs font-semibold rounded-xl bg-white text-zinc-950'); cSocial?.classList.remove('hidden'); }
    else { tabWeb3?.setAttribute('class','flex-1 py-2 text-xs font-semibold rounded-xl bg-white text-zinc-950'); cWeb3?.classList.remove('hidden'); }
  };
  tabEmail?.addEventListener('click', ()=> setTab('email'));
  tabSocial?.addEventListener('click', ()=> setTab('social'));
  tabWeb3?.addEventListener('click', ()=> setTab('web3'));
  window.addEventListener('wou:open-auth-modal', ()=> { hideErr(); modal?.classList.remove('hidden'); });
  window.addEventListener('wou:close-auth-modal', ()=> modal?.classList.add('hidden'));
  closeBtn?.addEventListener('click', ()=> wouAuth.closeModal());
  modal?.addEventListener('click', (e)=>{ if(e.target===modal) wouAuth.closeModal(); });
  formReq?.addEventListener('submit', async (e)=>{
    e.preventDefault(); hideErr(); currentEmail=inputEmail.value.trim(); if(!currentEmail) return;
    try{ await wouAuth.requestOtp(currentEmail); formReq.classList.add('hidden'); formVer.classList.remove('hidden'); if(titleEl) titleEl.textContent='Enter Security Code'; if(subEl) subEl.textContent=`Code sent to ${currentEmail}`; otpDigits[0]?.focus(); }catch(err:any){ showErr(err.message||'Failed'); }
  });
  const verifyCode=async(code:string)=>{ hideErr(); try{ await wouAuth.verifyOtp(currentEmail, code); showNotification('Signed in via OTP'); }catch(err:any){ showErr(err.message||'Invalid code'); }};
  otpDigits.forEach((d,idx)=>{
    d.addEventListener('input', (e)=>{
      const v=(e.target as HTMLInputElement).value.slice(-1); d.value=v; if(v && idx<5) otpDigits[idx+1].focus();
      const full=Array.from(otpDigits).map(x=>x.value).join(''); if(full.length===6) verifyCode(full);
    });
    d.addEventListener('paste', (e:ClipboardEvent)=>{
      e.preventDefault(); const t=(e.clipboardData?.getData('text')||'').replace(/\D/g,'').slice(0,6); if(!t) return; t.split('').forEach((ch,i)=> { if(otpDigits[i]) otpDigits[i].value=ch; }); const full=Array.from(otpDigits).map(x=>x.value).join(''); if(full.length===6) verifyCode(full);
    });
    d.addEventListener('keydown', (e)=>{ if(e.key==='Backspace' && !d.value && idx>0) otpDigits[idx-1].focus(); });
  });
  formVer?.addEventListener('submit', (e)=>{ e.preventDefault(); const full=Array.from(otpDigits).map(x=>x.value).join(''); if(full.length===6) verifyCode(full); });
  document.getElementById('btn-change-email')?.addEventListener('click', ()=>{ formVer.classList.add('hidden'); formReq.classList.remove('hidden'); if(titleEl) titleEl.textContent='Sign in to Ionic Swap'; if(subEl) subEl.textContent='Connect via email, social or Web3. Powered by id.worldofunreal.com'; otpDigits.forEach(x=> x.value=''); });
  document.getElementById('btn-resend-otp')?.addEventListener('click', async()=>{ try{ await wouAuth.requestOtp(currentEmail); showErr('New code sent!'); }catch(err:any){ showErr(err.message||'Resend failed'); }});
  document.querySelectorAll('.social-btn').forEach(btn=> btn.addEventListener('click', ()=>{ const p=btn.getAttribute('data-provider') as any; if(p) wouAuth.loginWithOAuth(p); }));
  document.getElementById('web3-solana')?.addEventListener('click', async()=>{ hideErr(); try{ await wouAuth.loginWithSolana(); showNotification('Solana linked'); }catch(e:any){ showErr(e.message); }});
  document.getElementById('web3-evm')?.addEventListener('click', async()=>{ hideErr(); try{ await wouAuth.loginWithEthereum(); showNotification('EVM linked'); }catch(e:any){ showErr(e.message); }});
  document.getElementById('web3-icp')?.addEventListener('click', async()=>{ hideErr(); try{ await wouAuth.loginWithIcp(); showNotification('ICP linked'); }catch(e:any){ showErr(e.message); }});
  // ensure no fake logged-in on first paint
  if (!wouAuth.isAuthenticated()) { signinBtn?.classList.remove('hidden'); userPill?.classList.add('hidden'); }

  //Theme switcher trigger
  const themeBtn = document.getElementById('theme-toggle');
  themeBtn?.addEventListener('click', () => {
    const html = document.documentElement;
    if (html.classList.contains('dark')) {
      html.classList.remove('dark');
      localStorage.setItem('ionic-swap-theme', 'light');
    } else {
      html.classList.add('dark');
      localStorage.setItem('ionic-swap-theme', 'dark');
    }
  });

  // Read theme on load
  const prefTheme = localStorage.getItem('ionic-swap-theme') || 'dark';
  if (prefTheme === 'dark') {
    document.documentElement.classList.add('dark');
  } else {
    document.documentElement.classList.remove('dark');
  }
</script>
